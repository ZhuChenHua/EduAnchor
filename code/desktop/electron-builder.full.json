{
  "appId": "com.eduanchor.desktop",
  "productName": "EduAnchor",
  "directories": {
    "output": "release-full"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../engine/dist/eduanchor-engine",
      "to": "engine",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../models/Qwen3-8B-GGUF",
      "to": "models/Qwen3-8B-GGUF",
      "filter": [
        "*.gguf"
      ]
    },
    {
      "from": "../../runtime/llama",
      "to": "llama",
      "filter": [
        "*.exe",
        "*.dll",
        "LICENSE*"
      ]
    }
  ],
  "win": {
    "target": [
      "zip"
    ],
    "signAndEditExecutable": false
  },
  "compression": "store"
}
